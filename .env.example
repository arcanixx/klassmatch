# =============================================================================
# .env.example — KlassMate
# Skopiuj do .env.development i .env.production, uzupełnij wartości.
# Ten plik JEST commitowany. .env.development i .env.production NIE SĄ.
# =============================================================================

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Znajdziesz w: Supabase Dashboard → Settings → API

# Publiczny URL projektu Supabase (możesz commitować — nie jest sekretem)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Klucz anon (publiczny) — bezpieczny w aplikacji klienckiej
# Supabase Dashboard → Settings → API → Project API keys → anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# UWAGA: Service Role Key NIGDY nie trafia do aplikacji klienckiej.
# Używany wyłącznie w Edge Functions (server-side).
# Nie dodawaj go tutaj — ustaw bezpośrednio w Supabase Dashboard → Edge Functions → Secrets.

# ─── SENTRY ──────────────────────────────────────────────────────────────────
# Znajdziesz w: sentry.io → Project → Settings → Client Keys (DSN)
# Pozostaw puste jeśli nie chcesz raportowania błędów (np. lokalne dev)

EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx

# ─── REVENUECAT ──────────────────────────────────────────────────────────────
# Znajdziesz w: app.revenuecat.com → Project → API Keys
# Faza 3 — pozostaw puste w MVP

EXPO_PUBLIC_REVENUECAT_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── ADMOB ────────────────────────────────────────────────────────────────────
# Znajdziesz w: admob.google.com → Apps → App ID
# Faza 3 — pozostaw puste w MVP

EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ─── OCR (FALLBACK) ──────────────────────────────────────────────────────────
# OCR.space free tier — nie wymaga rejestracji, ale możesz ustawić własny klucz
# dla wyższego limitu (500 req/dzień → 25000 req/mies. na darmowym koncie)
# https://ocr.space/ocrapi — rejestracja emailem, bezpłatna

# Pozostaw puste dla domyślnego klucza demo (ograniczony limit na IP)
EXPO_PUBLIC_OCRSPACE_API_KEY=

# ─── FEATURE FLAGS (DEV ONLY) ─────────────────────────────────────────────────
# Poniższe flagi działają TYLKO gdy __DEV__ === true (Expo development build)
# W production buildzie są ignorowane niezależnie od wartości

# Włącz panel debugowania (zakładka 🐛 w bottom bar)
EXPO_PUBLIC_DEBUG_MODE=false

# Zastąp prawdziwy Edge Function moderacji — local mock (patrz docs/07_TESTING_AND_DEBUG.md)
# Format: [REJECT] w treści → odrzucenie, [REVIEW] → kolejka, inne → zatwierdź
EXPO_PUBLIC_MOCK_MODERATION=false

# Wyświetl powiadomienia push lokalnie (bez prawdziwego Expo Push Service)
EXPO_PUBLIC_MOCK_PUSH=false

# Zwróć przykładowy tekst OCR zamiast prawdziwej analizy obrazu
EXPO_PUBLIC_MOCK_OCR=false

# Pokaż seed data w interfejsie (dane testowe z supabase/seed/dev_seed.sql)
EXPO_PUBLIC_SHOW_SEED=false

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
# Informacje o aplikacji (nie nadpisują app.config.ts — tylko dla logów/Sentry)

EXPO_PUBLIC_APP_NAME=KlassMate
EXPO_PUBLIC_APP_VERSION=0.1.0

# Environment: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# ─── NOTATKI ──────────────────────────────────────────────────────────────────
# Dla .env.production:
#   - EXPO_PUBLIC_DEBUG_MODE=false (ZAWSZE)
#   - EXPO_PUBLIC_MOCK_*=false (ZAWSZE)
#   - EXPO_PUBLIC_APP_ENV=production
#
# Dla .env.development:
#   - Możesz ustawić DEBUG_MODE=true dla lokalnego dewelopmentu
#   - Użyj osobnego projektu Supabase (dev.supabase.co) — NIE produkcyjnego!
#
# Weryfikacja przed build produkcyjnym:
#   grep "DEBUG_MODE=true\|MOCK_=true" .env.production
#   → powinno zwrócić 0 wyników
